{
  "name": "git-tools",
  "version": "0.0.0",
  "description": "Git tools for coding agents: state, commits, rewrites and stacked branches, worktrees and pushing.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craftsamo"
  },
  "homepage": "https://github.com/craft-agent/git-tools#readme",
  "repository": "https://github.com/craft-agent/git-tools",
  "license": "MIT",
  "skills": "./skills",
  "mcpServers": {
    "git-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "env_vars": [
        "GIT_TOOLS_TOOLSETS",
        "GIT_TOOLS_READ_ONLY",
        "GIT_TOOLS_TOOLS",
        "GIT_TOOLS_EXCLUDE_TOOLS",
        "GIT_TOOLS_CONFIRM",
        "LANGUAGE",
        "LC_CTYPE",
        "LC_MESSAGES",
        "XDG_CONFIG_HOME",
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS",
        "SSH_AUTH_SOCK",
        "GIT_SSH_COMMAND",
        "GNUPGHOME",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "ALL_PROXY",
        "https_proxy",
        "http_proxy",
        "no_proxy",
        "all_proxy",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_ENTERPRISE_TOKEN",
        "GITHUB_ENTERPRISE_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA",
        "HOMEDRIVE",
        "HOMEPATH",
        "SystemRoot",
        "PATHEXT",
        "ComSpec",
        "TEMP",
        "TMP"
      ]
    }
  }
}
